# Database owned by you
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=submind

# Protect the single-owner API. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SUBMIND_API_TOKEN=replace-with-a-long-random-token

# Optional server-side fallbacks. Leave blank when entering keys in the phone Profile.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Provider models/endpoints
GEMINI_FAST_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro
OPENAI_STT_MODEL=whisper-1
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta
OPENAI_API_URL=https://api.openai.com/v1

# Browser origins only; native Expo requests do not use browser CORS.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
